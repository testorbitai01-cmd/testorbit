# ─────────────────────────────────────────────────────────────
# Test Orbit — environment template.
# Copy to `.env` (repo root) and fill in real values. NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development
PORT=4000
# Interface to bind. Use 0.0.0.0 on Railway / containers.
HOST=0.0.0.0
# Public origin of the app (scheme + host [+ port]). Used for CSRF origin checks.
# Local dev (Vite dev server proxies /api to the server): http://localhost:5173
APP_ORIGIN=http://localhost:5173
# Number of trusted reverse-proxy hops in front of Node (sets Express `trust proxy`).
#   0 = local dev · 1 = Railway only · 2 = Cloudflare (proxied) → Railway
TRUST_PROXY=0

# PostgreSQL — runtime connection (used by the app).
#   Local:    postgresql://postgres:CHANGE_ME@localhost:5432/test_orbit?schema=public
#   Supabase: transaction pooler, port 6543. `pgbouncer=true` disables prepared statements;
#             `connection_limit` caps Prisma's pool PER REPLICA (keep replicas × limit below
#             the Supabase pooler's pool size); `pool_timeout` is how long a request waits for one.
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=20&pool_timeout=20
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/test_orbit?schema=public
# PostgreSQL — migration connection (used only by `prisma migrate`). Required by prisma/schema.prisma.
#   Local:    same value as DATABASE_URL
#   Supabase: session pooler, port 5432 (no pgbouncer flag)
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DIRECT_URL=postgresql://postgres:CHANGE_ME@localhost:5432/test_orbit?schema=public
# Separate database used by the automated API tests (it is wiped between tests!)
TEST_DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/test_orbit_test?schema=public

# Long random string (>= 32 chars). Used as a pepper when hashing session tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# Initial administrator (only used by `npm run admin:bootstrap` when no admin exists).
# The admin is forced to change this password at first login.
ADMIN_BOOTSTRAP_EMAIL=admin@gradtwin.com
ADMIN_BOOTSTRAP_PASSWORD=

# Identity-photo storage:
#   local    — filesystem directory (a Railway Volume in production; limits the API to ONE replica)
#   supabase — private Supabase Storage bucket (shared by all replicas; recommended in production)
#   disabled — no photos are stored; the capture step still verifies the camera
PHOTO_STORAGE_DRIVER=local
PHOTO_STORAGE_DIR=./storage/identity-photos
# Required when PHOTO_STORAGE_DRIVER=supabase (Project Settings → API). SERVER-SIDE ONLY: the
# service-role key bypasses all Storage policies — never expose it to the browser or commit it.
# Create the bucket in Storage → New bucket, name below, "Public bucket" OFF.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=identity-photos
